{
  "name": "willitraintomorrow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "prettier": "prettier --write \"**/*.{html,ts,tsx,js,json,md,mdx,mjs}\"",
    "clear-cache": "rm -rf .next",
    "unused": "next-unused",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^12.10.5",
    "geist": "^1.7.2",
    "html-escaper": "^3.0.3",
    "lucide-react": "^0.544.0",
    "next": "^16.3.4",
    "next-share": "^0.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.71.2",
    "react-server-dom-webpack": "^19.2.8",
    "react-wrap-balancer": "^1.1.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.0.0-beta.9",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.1.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "next-unused": "^0.0.6",
    "png-to-ico": "^3.0.2",
    "postcss": "^8",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "next-unused": {
    "debug": true,
    "include": [
      "app",
      "components",
      "config",
      "hooks",
      "lib",
      "styles"
    ],
    "entrypoints": [
      "app"
    ]
  },
  "type": "module"
}
