# Weather API
NEXT_WEATHER_API_KEY=

# Stock photos (hero) — use one or both; switch with WEATHER_PHOTO_PROVIDER
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Alternative env name supported for Unsplash:
# UNSPLASH_API_KEY=

# pexels | unsplash
WEATHER_PHOTO_PROVIDER=pexels

# Cache TTL for hero photo API responses (seconds). Default 604800 (7 days).
WEATHER_PHOTO_CACHE_REVALIDATE_SECONDS=604800

# Set to 1 to skip stock API calls (static fallback images only).
# WEATHER_PHOTO_DISABLED=1

NEXT_PUBLIC_IMAGEKIT_ID=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
